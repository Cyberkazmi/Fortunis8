# Copy to supabase/functions/.env locally; do not commit the populated file.
# For production, set TELEGRAM_BOT_TOKEN and TELEGRAM_WEBHOOK_SECRET in the
# Supabase Dashboard's Edge Function Secrets page, not in Git or Telegram chats.
TELEGRAM_BOT_TOKEN=replace-with-active-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-random-32-to-256-character-token
PREMIUM_PALM_PRICE_STARS=25
# SUPABASE_URL and the default server-only API key are injected by Supabase.
# For local function serving only, you may supply these through the ignored .env:
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
